<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner (no test framework, so it builds offline).
       Usage: DrgSave.Tests <a .sav file or a folder of them> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DrgSave.Tests</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrgSave.Core\DrgSave.Core.csproj" />
  </ItemGroup>

</Project>
